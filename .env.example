# Firebreak — every environment variable (docs/13 §2). Copy the relevant blocks:
#   apps/web/.env.local   ← WEB block
#   apps/mcp/.env         ← MCP block
#   packages/core/.env    ← DATABASE_URL / DATABASE_URL_UNPOOLED (migrations, tests)
#   packages/fixtures/.env← FIXTURES block
# Never commit real values.

# ───────────── WEB (apps/web, Vercel) ─────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MCP_URL=http://localhost:3005/mcp
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=                 # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=               # the GitHub App's own client id (not the OAuth App's)
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_WEBHOOK_SECRET=              # openssl rand -hex 32
STATE_SECRET=                       # openssl rand -base64 32
ENCRYPTION_KEY=                     # openssl rand -base64 32  (SAME value in MCP)
ENCRYPTION_KEY_PREVIOUS=            # only during key rotation
INNGEST_SIGNING_KEY=                # prod only (Inngest Vercel integration sets it)
INNGEST_EVENT_KEY=                  # prod only
INNGEST_DEV=1                       # local only — talk to the Inngest Dev Server (npx inngest-cli@latest dev)
DEFAULT_AI_PROVIDER=anthropic       # anthropic | openai | google | xai  (leave empty = BYOK only)
DEFAULT_AI_MODEL=claude-haiku-5-5
DEFAULT_AI_API_KEY=
AI_DEFAULT_DAILY_LIMIT=20
ACTION_APPROVAL_TTL_MIN=15
VERIFY_REQUIRED_STREAK=3
VERIFY_MAX_PROBES=18
VERIFY_INTERVAL_S=10
LOG_LEVEL=info
RESEND_API_KEY=                   # re_... from resend.com (free tier: 3000/mo, 100/day)
RESEND_FROM_EMAIL="Firebreak <notifications@yourdomain.com>" # prod: verified domain; dev fallback: Firebreak <onboarding@resend.dev>

# ───────────── MCP (apps/mcp, Northflank) ─────────────
NODE_ENV=development
MCP_TRANSPORT_TYPE=stdio            # prod: http
PORT=3005                           # prod: 3000
HOST=localhost                      # prod/container: 0.0.0.0
ENABLE_CORS=true
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require   # same as web
ENCRYPTION_KEY=                     # same as web
INNGEST_EVENT_KEY=                  # prod only
INNGEST_DEV=1                       # local only
FIREBREAK_APP_URL=http://localhost:3000
FIREBREAK_MCP_KEY=                  # stdio/dev only (create in /app/settings/mcp)

# ───────────── FIXTURES (packages/fixtures) ─────────────
FIREBREAK_URL=http://localhost:3000
FIREBREAK_SERVICE_ID=
FIREBREAK_ALERT_SECRET=
DEMO_REPO_PATH=../firebreak-demo
DEMO_HEALTH_URL=https://firebreak-demo.vercel.app/api/health
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ───────────── TESTS / TOOLING (optional) ─────────────
DATABASE_URL_TEST=                  # Neon "test" branch; DB-backed tests skip when empty
MCP_URL=http://localhost:3005/mcp   # apps/mcp smoke script
TEST_AI_PROVIDER=anthropic          # pnpm test:ai
TEST_AI_API_KEY=
