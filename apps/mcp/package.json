    "@nitrostack/cli": "^1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3"
  },
  "author": "Firebreak",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
